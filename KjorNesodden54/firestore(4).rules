rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function hasUserDocument() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return hasUserDocument() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    function isCustomer() {
      return hasUserDocument() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "customer";
    }

    function isRestaurant() {
      return hasUserDocument() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "restaurant";
    }

    function isActiveWorker() {
      return hasUserDocument() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'worker' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true;
    }

    function currentRestaurantId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.restaurantId;
    }


    function validDeliveryArea(value) {
      return value in ['tangen', 'bjornemyr', 'alvaern', 'fjellstrand', 'fagerstrand'];
    }

    function validDeliveryAmount(value) {
      return value is int && value >= 0 && value <= 10000;
    }

    function validDeliveryPricing(data) {
      return data.keys().hasAll(['schemaVersion', 'sameAreaFee', 'areaFees', 'revision', 'updatedAt', 'updatedBy']) &&
        data.keys().hasOnly(['schemaVersion', 'sameAreaFee', 'areaFees', 'revision', 'updatedAt', 'updatedBy']) &&
        data.schemaVersion == 1 && validDeliveryAmount(data.sameAreaFee) &&
        data.areaFees is map &&
        data.areaFees.keys().hasAll(['tangen', 'bjornemyr', 'alvaern', 'fjellstrand', 'fagerstrand']) &&
        data.areaFees.keys().hasOnly(['tangen', 'bjornemyr', 'alvaern', 'fjellstrand', 'fagerstrand']) &&
        validDeliveryAmount(data.areaFees.tangen) && validDeliveryAmount(data.areaFees.bjornemyr) &&
        validDeliveryAmount(data.areaFees.alvaern) && validDeliveryAmount(data.areaFees.fjellstrand) &&
        validDeliveryAmount(data.areaFees.fagerstrand) &&
        data.revision is int && data.revision >= 1 &&
        data.updatedAt == request.time && data.updatedBy == request.auth.uid;
    }

    function validOrderDelivery(data) {
      return !data.keys().hasAny(['delivery']) || (
        data.delivery is map &&
        data.delivery.keys().hasAll(['fee', 'routeFee', 'customerAreaId', 'restaurantAreaId', 'pricingRevision']) &&
        data.delivery.keys().hasOnly(['fee', 'routeFee', 'customerAreaId', 'restaurantAreaId', 'pricingRevision']) &&
        (data.delivery.fee == null || validDeliveryAmount(data.delivery.fee)) &&
        (data.delivery.routeFee == null || validDeliveryAmount(data.delivery.routeFee)) &&
        (data.delivery.customerAreaId == null || validDeliveryArea(data.delivery.customerAreaId)) &&
        (data.delivery.restaurantAreaId == null || validDeliveryArea(data.delivery.restaurantAreaId)) &&
        data.delivery.pricingRevision is int && data.delivery.pricingRevision >= 0
      );
    }


    function validAppPlatformUpdate(data, platform) {
      return data is map &&
        data.keys().hasAll(['enabled', 'minimumVersion', 'storeUrl']) &&
        data.keys().hasOnly(['enabled', 'minimumVersion', 'storeUrl']) &&
        data.enabled is bool && data.minimumVersion is string && data.storeUrl is string &&
        (data.minimumVersion == '' || data.minimumVersion.matches('(0|[1-9][0-9]{0,4})[.](0|[1-9][0-9]{0,4})[.](0|[1-9][0-9]{0,4})')) &&
        (data.storeUrl == '' ||
          (platform == 'ios' && data.storeUrl.matches('https://apps[.]apple[.]com/([a-z]{2}/)?app/([a-zA-Z0-9_%.-]+/)?id[0-9]+')) ||
          (platform == 'android' && data.storeUrl == 'https://play.google.com/store/apps/details?id=com.kjornesodden.app')) &&
        (!data.enabled || (data.minimumVersion != '' && data.storeUrl != ''));
    }

    function validAppUpdatePolicy(data) {
      return data.keys().hasAll(['schemaVersion', 'revision', 'ios', 'android', 'updatedAt', 'updatedBy']) &&
        data.keys().hasOnly(['schemaVersion', 'revision', 'ios', 'android', 'updatedAt', 'updatedBy']) &&
        data.schemaVersion == 1 && data.revision is int && data.revision >= 1 &&
        validAppPlatformUpdate(data.ios, 'ios') && validAppPlatformUpdate(data.android, 'android') &&
        data.updatedAt == request.time && data.updatedBy == request.auth.uid;
    }

    match /settings/appUpdates {
      allow read: if true;
      allow create: if isAdmin() && validAppUpdatePolicy(request.resource.data) &&
        request.resource.data.revision == 1;
      allow update: if isAdmin() && validAppUpdatePolicy(request.resource.data) &&
        request.resource.data.revision == resource.data.revision + 1;
      allow delete: if false;
    }

    match /settings/deliveryPricing {
      allow read: if true;
      allow create: if isAdmin() && validDeliveryPricing(request.resource.data) &&
        request.resource.data.revision == 1;
      allow update: if isAdmin() && validDeliveryPricing(request.resource.data) &&
        request.resource.data.revision == resource.data.revision + 1;
      allow delete: if false;
    }

    match /users/{userId} {
      allow read: if signedIn() &&
        (request.auth.uid == userId || isAdmin());

      allow create: if signedIn() &&
        (
          (
            request.auth.uid == userId &&
            request.resource.data.role == "customer" &&
            request.resource.data.keys().hasAll([
              "role", "name", "email", "phone", "address", "createdAt", "updatedAt"
            ]) &&
            request.resource.data.keys().hasOnly([
              "role", "name", "email", "phone", "address", "createdAt", "updatedAt"
            ]) &&
            request.resource.data.email == request.auth.token.email
          )
          ||
          (isAdmin() && request.resource.data.role == 'worker' &&
            request.resource.data.keys().hasAll(['role', 'name', 'email', 'active', 'createdAt']) &&
            request.resource.data.keys().hasOnly(['role', 'name', 'email', 'active', 'createdAt']) &&
            request.resource.data.name is string && request.resource.data.email is string &&
            request.resource.data.active == true && request.resource.data.createdAt == request.time)
          ||
          (
            isAdmin() &&
            request.resource.data.role == "restaurant" &&
            request.resource.data.keys().hasAll([
              "role", "restaurantId", "restaurantName", "createdAt"
            ]) &&
            request.resource.data.keys().hasOnly([
              "role", "restaurantId", "restaurantName", "createdAt"
            ])
          )
        );

      allow update: if signedIn() &&
        (
          (
            request.auth.uid == userId &&
            resource.data.role == "customer" &&
            request.resource.data.role == "customer" &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "name", "phone", "address", "deliveryFee", "deliveryZone", "deliveryAreaId", "deliveryAreaAddress", "deliveryCoordinates", "updatedAt"
            ])
          )
          ||
          isAdmin()
        );

      allow delete: if signedIn() &&
        (
          isAdmin() ||
          (
            request.auth.uid == userId &&
            resource.data.role == "customer"
          )
        );
    }

    match /restaurants/{restaurantId} {
      allow read: if
        (
          resource.data.active == true ||
          isAdmin() ||
          (
            isRestaurant() &&
            currentRestaurantId() == restaurantId
          )
        );

      allow create, update, delete: if isAdmin();
    }

    match /products/{productId} {
      allow read: if true;

      allow create: if
        (
          isAdmin() ||
          (
            isRestaurant() &&
            request.resource.data.restaurantId == currentRestaurantId()
          )
        ) &&
        request.resource.data.keys().hasAll([
          "restaurantId", "name", "description", "price", "imageData",
          "available", "createdAt", "updatedAt"
        ]) &&
        request.resource.data.keys().hasOnly([
          "restaurantId", "name", "description", "price", "imageData",
          "available", "createdAt", "updatedAt", "category", "sortOrder"
        ]) &&
        request.resource.data.name is string &&
        request.resource.data.description is string &&
        request.resource.data.price is number &&
        request.resource.data.price > 0 &&
        request.resource.data.imageData is string &&
        request.resource.data.available is bool &&
        (
          !request.resource.data.keys().hasAny(["category"]) ||
          request.resource.data.category is string
        ) &&
        (
          !request.resource.data.keys().hasAny(["sortOrder"]) ||
          request.resource.data.sortOrder is number
        );

      allow update: if
        isAdmin()
        ||
        (
          isRestaurant() &&
          resource.data.restaurantId == currentRestaurantId() &&
          request.resource.data.restaurantId == resource.data.restaurantId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "available", "updatedAt"
          ]) &&
          request.resource.data.available is bool
        );

      allow delete: if
        isAdmin()
        ||
        (
          isRestaurant() &&
          resource.data.restaurantId == currentRestaurantId()
        );
    }

    function feeAllowsDispatch(data) {
      return data.get('deliveryFee', null) != null &&
        !(data.get('feeProposal', {}).get('status', '') in ['pending', 'declined']);
    }

    match /users/{userId}/notifications/{notificationId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow update: if signedIn() && request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']) && request.resource.data.read == true;
      allow create, delete: if false;
    }
    match /users/{userId}/pushTokens/{tokenId} {
      allow read, delete: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn() && request.auth.uid == userId &&
        request.resource.data.keys().hasOnly(['token', 'updatedAt']) && request.resource.data.token is string &&
        request.resource.data.token.size() <= 256 && request.resource.data.updatedAt == request.time;
    }
    match /orderGroups/{orderId}/feeHistory/{proposalId} {
      allow read: if isAdmin() || (isCustomer() && get(/databases/$(database)/documents/orderGroups/$(orderId)).data.customerId == request.auth.uid) ||
        (isActiveWorker() && get(/databases/$(database)/documents/orderGroups/$(orderId)).data.assignedWorkerId == request.auth.uid);
      allow write: if false;
    }

    match /orderGroups/{orderId} {
      allow create: if isCustomer() &&
        request.resource.data.keys().hasAll(['customerId', 'customerName', 'customerPhone', 'address', 'coordinates', 'items', 'totalPrice', 'deliveryFee', 'status', 'createdAt', 'statusUpdatedAt']) &&
        request.resource.data.keys().hasOnly(['customerId', 'customerName', 'customerPhone', 'address', 'coordinates', 'items', 'totalPrice', 'deliveryFee', 'status', 'createdAt', 'statusUpdatedAt', 'assignmentStatus', 'assignedWorkerId']) &&
        (!request.resource.data.keys().hasAny(['assignmentStatus', 'assignedWorkerId']) || (request.resource.data.assignmentStatus == 'available' && request.resource.data.assignedWorkerId == null)) &&
        request.resource.data.customerId == request.auth.uid &&
        request.resource.data.customerName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name &&
        request.resource.data.customerPhone == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.phone &&
        request.resource.data.address is string && request.resource.data.address.size() >= 5 &&
        (request.resource.data.coordinates == null || (request.resource.data.coordinates is map &&
          request.resource.data.coordinates.keys().hasOnly(['latitude', 'longitude']) &&
          request.resource.data.coordinates.latitude is number && request.resource.data.coordinates.latitude >= -90 && request.resource.data.coordinates.latitude <= 90 &&
          request.resource.data.coordinates.longitude is number && request.resource.data.coordinates.longitude >= -180 && request.resource.data.coordinates.longitude <= 180)) &&
        request.resource.data.items is list && request.resource.data.items.size() > 0 && request.resource.data.items.size() <= 100 &&
        request.resource.data.totalPrice is number && request.resource.data.totalPrice >= 0 &&
        (request.resource.data.deliveryFee == null || validDeliveryAmount(request.resource.data.deliveryFee)) &&
        request.resource.data.status == 'placed' && request.resource.data.createdAt == request.time && request.resource.data.statusUpdatedAt == request.time;
      allow read: if isAdmin() || (isCustomer() && resource.data.customerId == request.auth.uid) ||
        (isActiveWorker() && (resource.data.get('assignmentStatus', '') == 'available' || resource.data.get('assignedWorkerId', '') == request.auth.uid));
      allow update: if (isAdmin() && resource.data.get('assignmentStatus', '') == 'assigned' && resource.data.status in ['placed', 'confirmed', 'preparing', 'ready'] &&
        request.resource.data.assignmentStatus == 'available' && request.resource.data.assignedWorkerId == null && request.resource.data.releasedAt == request.time &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['assignmentStatus', 'assignedWorkerId', 'releasedAt'])) ||
        (isAdmin() && resource.data.get('assignmentStatus', null) == null && resource.data.get('assignedWorkerId', null) == null &&
        !(resource.data.status in ['delivered', 'cancelled']) && request.resource.data.assignmentStatus == 'available' && request.resource.data.assignedWorkerId == null &&
        request.resource.data.madeAvailableAt == request.time && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['assignmentStatus', 'assignedWorkerId', 'madeAvailableAt'])) ||
        (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'statusUpdatedAt']) &&
        request.resource.data.status in ['placed', 'confirmed', 'preparing', 'ready', 'picked_up', 'on_the_way', 'delivered', 'cancelled'] &&
        (!(request.resource.data.status in ['picked_up', 'on_the_way', 'delivered']) || feeAllowsDispatch(resource.data)) && request.resource.data.statusUpdatedAt == request.time) ||
        (isActiveWorker() && resource.data.get('assignmentStatus', '') == 'available' && resource.data.get('assignedWorkerId', null) == null &&
          !(resource.data.status in ['delivered', 'cancelled']) && request.resource.data.assignedWorkerId == request.auth.uid && request.resource.data.assignmentStatus == 'assigned' &&
          request.resource.data.assignedAt == request.time && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['assignmentStatus', 'assignedWorkerId', 'assignedAt'])) ||
        (isActiveWorker() && feeAllowsDispatch(resource.data) && resource.data.assignedWorkerId == request.auth.uid && resource.data.assignmentStatus == 'assigned' &&
          request.resource.data.statusUpdatedAt == request.time &&
          ((resource.data.status == 'ready' && request.resource.data.status == 'picked_up') || (resource.data.status == 'picked_up' && request.resource.data.status == 'on_the_way')) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'statusUpdatedAt'])) ||
        (isActiveWorker() && feeAllowsDispatch(resource.data) && resource.data.assignedWorkerId == request.auth.uid && resource.data.assignmentStatus == 'assigned' &&
          resource.data.status == 'on_the_way' && request.resource.data.status == 'delivered' && request.resource.data.assignmentStatus == 'completed' &&
          request.resource.data.statusUpdatedAt == request.time && request.resource.data.completedAt == request.time &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'statusUpdatedAt', 'assignmentStatus', 'completedAt']));
      allow delete: if false;
    }

    match /restaurantRequests/{requestId} {
      allow create: if isCustomer() && validOrderDelivery(request.resource.data) &&
        request.resource.data.customerId == request.auth.uid &&
        request.resource.data.customerName ==
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name &&
        request.resource.data.customerPhone ==
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.phone &&
        request.resource.data.status == "pending" &&
        request.resource.data.completedAt == null &&
        request.resource.data.restaurantId is string &&
        request.resource.data.restaurantName is string &&
        request.resource.data.customerName is string &&
        request.resource.data.customerPhone is string &&
        request.resource.data.orderGroupId is string &&
        request.resource.data.items is list &&
        request.resource.data.items.size() > 0 &&
        request.resource.data.items.size() <= 100 &&
        request.resource.data.subtotal is number &&
        request.resource.data.subtotal >= 0 &&
        request.resource.data.keys().hasAll([
          "orderGroupId", "restaurantId", "restaurantName", "customerId",
          "customerName", "customerPhone", "items", "subtotal",
          "status", "createdAt", "completedAt"
        ]) &&
        request.resource.data.keys().hasOnly([
          "orderGroupId", "restaurantId", "restaurantName", "customerId",
          "customerName", "customerPhone", "items", "subtotal",
          "status", "createdAt", "completedAt", "delivery"
        ]) &&
        exists(/databases/$(database)/documents/restaurants/$(request.resource.data.restaurantId)) &&
        get(/databases/$(database)/documents/restaurants/$(request.resource.data.restaurantId)).data.active == true;

      allow read: if
        isAdmin()
        ||
        (
          isRestaurant() &&
          resource.data.restaurantId == currentRestaurantId()
        )
        ||
        (
          isCustomer() &&
          resource.data.customerId == request.auth.uid
        );

      allow update: if
        isAdmin()
        ||
        (
          isRestaurant() &&
          resource.data.restaurantId == currentRestaurantId() &&
          request.resource.data.restaurantId == resource.data.restaurantId &&
          request.resource.data.customerId == resource.data.customerId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "status", "completedAt"
          ]) &&
          request.resource.data.status == "completed" &&
          request.resource.data.completedAt == request.time
        );

      allow delete: if
        isAdmin()
        ||
        (
          isCustomer() &&
          resource.data.customerId == request.auth.uid
        );
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

