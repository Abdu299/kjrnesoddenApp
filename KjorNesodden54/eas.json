{
  "cli": {
    "version": ">= 16.18.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_ORDER_API_URL": "https://www.kjornesodden.no/api/send"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_ORDER_API_URL": "https://www.kjornesodden.no/api/send"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_ORDER_API_URL": "https://www.kjornesodden.no/api/send"
      }
    }
  },
  "submit": {
    "production": {}
  }
}


