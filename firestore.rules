rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return signedIn() && currentUser().role == role;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isCustomer() {
      return hasRole('customer');
    }

    function isRestaurant() {
      return hasRole('restaurant');
    }

    function ownsRestaurant(restaurantId) {
      return isRestaurant() && currentUser().restaurantId == restaurantId;
    }


    function validDeliveryArea(value) {
      return value in ['tangen', 'bjornemyr', 'alvaern', 'fjellstrand', 'fagerstrand'];
    }

    function validDeliveryAmount(value) {
      return value is int && value >= 0 && value <= 10000;
    }

    function validDeliveryPricing(data) {
      return data.keys().hasAll(['schemaVersion', 'sameAreaFee', 'areaFees', 'revision', 'updatedAt', 'updatedBy']) &&
        data.keys().hasOnly(['schemaVersion', 'sameAreaFee', 'areaFees', 'revision', 'updatedAt', 'updatedBy']) &&
        data.schemaVersion == 1 && validDeliveryAmount(data.sameAreaFee) &&
        data.areaFees is map &&
        data.areaFees.keys().hasAll(['tangen', 'bjornemyr', 'alvaern', 'fjellstrand', 'fagerstrand']) &&
        data.areaFees.keys().hasOnly(['tangen', 'bjornemyr', 'alvaern', 'fjellstrand', 'fagerstrand']) &&
        validDeliveryAmount(data.areaFees.tangen) && validDeliveryAmount(data.areaFees.bjornemyr) &&
        validDeliveryAmount(data.areaFees.alvaern) && validDeliveryAmount(data.areaFees.fjellstrand) &&
        validDeliveryAmount(data.areaFees.fagerstrand) &&
        data.revision is int && data.revision >= 1 &&
        data.updatedAt == request.time && data.updatedBy == request.auth.uid;
    }

    function validOrderDelivery(data) {
      return !data.keys().hasAny(['delivery']) || (
        data.delivery is map &&
        data.delivery.keys().hasAll(['fee', 'routeFee', 'customerAreaId', 'restaurantAreaId', 'pricingRevision']) &&
        data.delivery.keys().hasOnly(['fee', 'routeFee', 'customerAreaId', 'restaurantAreaId', 'pricingRevision']) &&
        (data.delivery.fee == null || validDeliveryAmount(data.delivery.fee)) &&
        (data.delivery.routeFee == null || validDeliveryAmount(data.delivery.routeFee)) &&
        (data.delivery.customerAreaId == null || validDeliveryArea(data.delivery.customerAreaId)) &&
        (data.delivery.restaurantAreaId == null || validDeliveryArea(data.delivery.restaurantAreaId)) &&
        data.delivery.pricingRevision is int && data.delivery.pricingRevision >= 0
      );
    }


    function validAppPlatformUpdate(data, platform) {
      return data is map &&
        data.keys().hasAll(['enabled', 'minimumVersion', 'storeUrl']) &&
        data.keys().hasOnly(['enabled', 'minimumVersion', 'storeUrl']) &&
        data.enabled is bool && data.minimumVersion is string && data.storeUrl is string &&
        (data.minimumVersion == '' || data.minimumVersion.matches('(0|[1-9][0-9]{0,4})[.](0|[1-9][0-9]{0,4})[.](0|[1-9][0-9]{0,4})')) &&
        (data.storeUrl == '' ||
          (platform == 'ios' && data.storeUrl.matches('https://apps[.]apple[.]com/([a-z]{2}/)?app/([a-zA-Z0-9_%.-]+/)?id[0-9]+')) ||
          (platform == 'android' && data.storeUrl == 'https://play.google.com/store/apps/details?id=com.kjornesodden.app')) &&
        (!data.enabled || (data.minimumVersion != '' && data.storeUrl != ''));
    }

    function validAppUpdatePolicy(data) {
      return data.keys().hasAll(['schemaVersion', 'revision', 'ios', 'android', 'updatedAt', 'updatedBy']) &&
        data.keys().hasOnly(['schemaVersion', 'revision', 'ios', 'android', 'updatedAt', 'updatedBy']) &&
        data.schemaVersion == 1 && data.revision is int && data.revision >= 1 &&
        validAppPlatformUpdate(data.ios, 'ios') && validAppPlatformUpdate(data.android, 'android') &&
        data.updatedAt == request.time && data.updatedBy == request.auth.uid;
    }

    match /settings/appUpdates {
      allow read: if true;
      allow create: if isAdmin() && validAppUpdatePolicy(request.resource.data) &&
        request.resource.data.revision == 1;
      allow update: if isAdmin() && validAppUpdatePolicy(request.resource.data) &&
        request.resource.data.revision == resource.data.revision + 1;
      allow delete: if false;
    }

    match /settings/deliveryPricing {
      allow read: if true;
      allow create: if isAdmin() && validDeliveryPricing(request.resource.data) &&
        request.resource.data.revision == 1;
      allow update: if isAdmin() && validDeliveryPricing(request.resource.data) &&
        request.resource.data.revision == resource.data.revision + 1;
      allow delete: if false;
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());

      allow create: if signedIn() && (
        (request.auth.uid == userId && request.resource.data.role == 'customer') ||
        (isAdmin() && request.resource.data.role == 'restaurant')
      );

      allow update: if signedIn() && (
        (
          request.auth.uid == userId &&
          resource.data.role == 'customer' &&
          request.resource.data.role == resource.data.role
        ) ||
        isAdmin()
      );

      allow delete: if isAdmin();
    }

    match /restaurants/{restaurantId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /products/{productId} {
      allow read: if true;

      allow create: if ownsRestaurant(request.resource.data.restaurantId);

      allow update: if ownsRestaurant(resource.data.restaurantId) &&
        request.resource.data.restaurantId == resource.data.restaurantId;

      allow delete: if ownsRestaurant(resource.data.restaurantId) || isAdmin();
    }

    match /orderGroups/{orderId} {
      allow create: if isCustomer() &&
        request.resource.data.keys().hasAll(['customerId', 'customerName', 'customerPhone', 'address', 'coordinates', 'items', 'totalPrice', 'deliveryFee', 'status', 'createdAt', 'statusUpdatedAt']) &&
        request.resource.data.keys().hasOnly(['customerId', 'customerName', 'customerPhone', 'address', 'coordinates', 'items', 'totalPrice', 'deliveryFee', 'status', 'createdAt', 'statusUpdatedAt']) &&
        request.resource.data.customerId == request.auth.uid &&
        request.resource.data.customerName == currentUser().name &&
        request.resource.data.customerPhone == currentUser().phone &&
        request.resource.data.address is string && request.resource.data.address.size() >= 5 &&
        (request.resource.data.coordinates == null || (request.resource.data.coordinates is map &&
          request.resource.data.coordinates.keys().hasOnly(['latitude', 'longitude']) &&
          request.resource.data.coordinates.latitude is number && request.resource.data.coordinates.latitude >= -90 && request.resource.data.coordinates.latitude <= 90 &&
          request.resource.data.coordinates.longitude is number && request.resource.data.coordinates.longitude >= -180 && request.resource.data.coordinates.longitude <= 180)) &&
        request.resource.data.items is list && request.resource.data.items.size() > 0 && request.resource.data.items.size() <= 100 &&
        request.resource.data.totalPrice is number && request.resource.data.totalPrice >= 0 &&
        (request.resource.data.deliveryFee == null || validDeliveryAmount(request.resource.data.deliveryFee)) &&
        request.resource.data.status == 'placed' && request.resource.data.createdAt == request.time && request.resource.data.statusUpdatedAt == request.time;
      allow read: if isAdmin() || (isCustomer() && resource.data.customerId == request.auth.uid);
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'statusUpdatedAt']) &&
        request.resource.data.status in ['placed', 'confirmed', 'preparing', 'ready', 'picked_up', 'on_the_way', 'delivered', 'cancelled'] && request.resource.data.statusUpdatedAt == request.time;
      allow delete: if false;
    }

    match /restaurantRequests/{requestId} {
      allow create: if isCustomer() && validOrderDelivery(request.resource.data) &&
        request.resource.data.customerId == request.auth.uid &&
        request.resource.data.status == 'pending';

      allow read: if signedIn() && (
        resource.data.customerId == request.auth.uid ||
        ownsRestaurant(resource.data.restaurantId) ||
        isAdmin()
      );

      allow update: if ownsRestaurant(resource.data.restaurantId) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'completedAt']) &&
        request.resource.data.status == 'completed';

      allow delete: if isAdmin();
    }

    // Written only by the trusted Cloud Function through the Admin SDK.
    match /telegramRateLimits/{userId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

