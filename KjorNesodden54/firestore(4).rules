rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function hasUserDocument() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return hasUserDocument() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    function isCustomer() {
      return hasUserDocument() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "customer";
    }

    function isRestaurant() {
      return hasUserDocument() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "restaurant";
    }

    function currentRestaurantId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.restaurantId;
    }


    function validDeliveryArea(value) {
      return value in ['tangen', 'bjornemyr', 'alvaern', 'fjellstrand', 'fagerstrand'];
    }

    function validDeliveryAmount(value) {
      return value is int && value >= 0 && value <= 10000;
    }

    function validDeliveryPricing(data) {
      return data.keys().hasAll(['schemaVersion', 'sameAreaFee', 'areaFees', 'revision', 'updatedAt', 'updatedBy']) &&
        data.keys().hasOnly(['schemaVersion', 'sameAreaFee', 'areaFees', 'revision', 'updatedAt', 'updatedBy']) &&
        data.schemaVersion == 1 && validDeliveryAmount(data.sameAreaFee) &&
        data.areaFees is map &&
        data.areaFees.keys().hasAll(['tangen', 'bjornemyr', 'alvaern', 'fjellstrand', 'fagerstrand']) &&
        data.areaFees.keys().hasOnly(['tangen', 'bjornemyr', 'alvaern', 'fjellstrand', 'fagerstrand']) &&
        validDeliveryAmount(data.areaFees.tangen) && validDeliveryAmount(data.areaFees.bjornemyr) &&
        validDeliveryAmount(data.areaFees.alvaern) && validDeliveryAmount(data.areaFees.fjellstrand) &&
        validDeliveryAmount(data.areaFees.fagerstrand) &&
        data.revision is int && data.revision >= 1 &&
        data.updatedAt == request.time && data.updatedBy == request.auth.uid;
    }

    function validOrderDelivery(data) {
      return !data.keys().hasAny(['delivery']) || (
        data.delivery is map &&
        data.delivery.keys().hasAll(['fee', 'routeFee', 'customerAreaId', 'restaurantAreaId', 'pricingRevision']) &&
        data.delivery.keys().hasOnly(['fee', 'routeFee', 'customerAreaId', 'restaurantAreaId', 'pricingRevision']) &&
        (data.delivery.fee == null || validDeliveryAmount(data.delivery.fee)) &&
        (data.delivery.routeFee == null || validDeliveryAmount(data.delivery.routeFee)) &&
        (data.delivery.customerAreaId == null || validDeliveryArea(data.delivery.customerAreaId)) &&
        (data.delivery.restaurantAreaId == null || validDeliveryArea(data.delivery.restaurantAreaId)) &&
        data.delivery.pricingRevision is int && data.delivery.pricingRevision >= 0
      );
    }

    match /settings/deliveryPricing {
      allow read: if true;
      allow create: if isAdmin() && validDeliveryPricing(request.resource.data) &&
        request.resource.data.revision == 1;
      allow update: if isAdmin() && validDeliveryPricing(request.resource.data) &&
        request.resource.data.revision == resource.data.revision + 1;
      allow delete: if false;
    }

    match /users/{userId} {
      allow read: if signedIn() &&
        (request.auth.uid == userId || isAdmin());

      allow create: if signedIn() &&
        (
          (
            request.auth.uid == userId &&
            request.resource.data.role == "customer" &&
            request.resource.data.keys().hasAll([
              "role", "name", "email", "phone", "address", "createdAt", "updatedAt"
            ]) &&
            request.resource.data.keys().hasOnly([
              "role", "name", "email", "phone", "address", "createdAt", "updatedAt"
            ]) &&
            request.resource.data.email == request.auth.token.email
          )
          ||
          (
            isAdmin() &&
            request.resource.data.role == "restaurant" &&
            request.resource.data.keys().hasAll([
              "role", "restaurantId", "restaurantName", "createdAt"
            ]) &&
            request.resource.data.keys().hasOnly([
              "role", "restaurantId", "restaurantName", "createdAt"
            ])
          )
        );

      allow update: if signedIn() &&
        (
          (
            request.auth.uid == userId &&
            resource.data.role == "customer" &&
            request.resource.data.role == "customer" &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "name", "phone", "address", "deliveryFee", "deliveryZone", "deliveryAreaId", "deliveryAreaAddress", "updatedAt"
            ])
          )
          ||
          isAdmin()
        );

      allow delete: if signedIn() &&
        (
          isAdmin() ||
          (
            request.auth.uid == userId &&
            resource.data.role == "customer"
          )
        );
    }

    match /restaurants/{restaurantId} {
      allow read: if
        (
          resource.data.active == true ||
          isAdmin() ||
          (
            isRestaurant() &&
            currentRestaurantId() == restaurantId
          )
        );

      allow create, update, delete: if isAdmin();
    }

    match /products/{productId} {
      allow read: if true;

      allow create: if
        (
          isAdmin() ||
          (
            isRestaurant() &&
            request.resource.data.restaurantId == currentRestaurantId()
          )
        ) &&
        request.resource.data.keys().hasAll([
          "restaurantId", "name", "description", "price", "imageData",
          "available", "createdAt", "updatedAt"
        ]) &&
        request.resource.data.keys().hasOnly([
          "restaurantId", "name", "description", "price", "imageData",
          "available", "createdAt", "updatedAt", "category", "sortOrder"
        ]) &&
        request.resource.data.name is string &&
        request.resource.data.description is string &&
        request.resource.data.price is number &&
        request.resource.data.price > 0 &&
        request.resource.data.imageData is string &&
        request.resource.data.available is bool &&
        (
          !request.resource.data.keys().hasAny(["category"]) ||
          request.resource.data.category is string
        ) &&
        (
          !request.resource.data.keys().hasAny(["sortOrder"]) ||
          request.resource.data.sortOrder is number
        );

      allow update: if
        isAdmin()
        ||
        (
          isRestaurant() &&
          resource.data.restaurantId == currentRestaurantId() &&
          request.resource.data.restaurantId == resource.data.restaurantId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "available", "updatedAt"
          ]) &&
          request.resource.data.available is bool
        );

      allow delete: if
        isAdmin()
        ||
        (
          isRestaurant() &&
          resource.data.restaurantId == currentRestaurantId()
        );
    }

    match /restaurantRequests/{requestId} {
      allow create: if isCustomer() && validOrderDelivery(request.resource.data) &&
        request.resource.data.customerId == request.auth.uid &&
        request.resource.data.customerName ==
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name &&
        request.resource.data.customerPhone ==
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.phone &&
        request.resource.data.status == "pending" &&
        request.resource.data.completedAt == null &&
        request.resource.data.restaurantId is string &&
        request.resource.data.restaurantName is string &&
        request.resource.data.customerName is string &&
        request.resource.data.customerPhone is string &&
        request.resource.data.orderGroupId is string &&
        request.resource.data.items is list &&
        request.resource.data.items.size() > 0 &&
        request.resource.data.items.size() <= 100 &&
        request.resource.data.subtotal is number &&
        request.resource.data.subtotal >= 0 &&
        request.resource.data.keys().hasAll([
          "orderGroupId", "restaurantId", "restaurantName", "customerId",
          "customerName", "customerPhone", "items", "subtotal",
          "status", "createdAt", "completedAt"
        ]) &&
        request.resource.data.keys().hasOnly([
          "orderGroupId", "restaurantId", "restaurantName", "customerId",
          "customerName", "customerPhone", "items", "subtotal",
          "status", "createdAt", "completedAt", "delivery"
        ]) &&
        exists(/databases/$(database)/documents/restaurants/$(request.resource.data.restaurantId)) &&
        get(/databases/$(database)/documents/restaurants/$(request.resource.data.restaurantId)).data.active == true;

      allow read: if
        isAdmin()
        ||
        (
          isRestaurant() &&
          resource.data.restaurantId == currentRestaurantId()
        )
        ||
        (
          isCustomer() &&
          resource.data.customerId == request.auth.uid
        );

      allow update: if
        isAdmin()
        ||
        (
          isRestaurant() &&
          resource.data.restaurantId == currentRestaurantId() &&
          request.resource.data.restaurantId == resource.data.restaurantId &&
          request.resource.data.customerId == resource.data.customerId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "status", "completedAt"
          ]) &&
          request.resource.data.status == "completed" &&
          request.resource.data.completedAt == request.time
        );

      allow delete: if
        isAdmin()
        ||
        (
          isCustomer() &&
          resource.data.customerId == request.auth.uid
        );
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

