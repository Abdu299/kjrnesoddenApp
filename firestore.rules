rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return signedIn() && currentUser().role == role;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isCustomer() {
      return hasRole('customer');
    }

    function isRestaurant() {
      return hasRole('restaurant');
    }

    function ownsRestaurant(restaurantId) {
      return isRestaurant() && currentUser().restaurantId == restaurantId;
    }


    function validDeliveryArea(value) {
      return value in ['tangen', 'bjornemyr', 'alvaern', 'fjellstrand', 'fagerstrand'];
    }

    function validDeliveryAmount(value) {
      return value is int && value >= 0 && value <= 10000;
    }

    function validDeliveryPricing(data) {
      return data.keys().hasAll(['schemaVersion', 'sameAreaFee', 'areaFees', 'revision', 'updatedAt', 'updatedBy']) &&
        data.keys().hasOnly(['schemaVersion', 'sameAreaFee', 'areaFees', 'revision', 'updatedAt', 'updatedBy']) &&
        data.schemaVersion == 1 && validDeliveryAmount(data.sameAreaFee) &&
        data.areaFees is map &&
        data.areaFees.keys().hasAll(['tangen', 'bjornemyr', 'alvaern', 'fjellstrand', 'fagerstrand']) &&
        data.areaFees.keys().hasOnly(['tangen', 'bjornemyr', 'alvaern', 'fjellstrand', 'fagerstrand']) &&
        validDeliveryAmount(data.areaFees.tangen) && validDeliveryAmount(data.areaFees.bjornemyr) &&
        validDeliveryAmount(data.areaFees.alvaern) && validDeliveryAmount(data.areaFees.fjellstrand) &&
        validDeliveryAmount(data.areaFees.fagerstrand) &&
        data.revision is int && data.revision >= 1 &&
        data.updatedAt == request.time && data.updatedBy == request.auth.uid;
    }

    function validOrderDelivery(data) {
      return !data.keys().hasAny(['delivery']) || (
        data.delivery is map &&
        data.delivery.keys().hasAll(['fee', 'routeFee', 'customerAreaId', 'restaurantAreaId', 'pricingRevision']) &&
        data.delivery.keys().hasOnly(['fee', 'routeFee', 'customerAreaId', 'restaurantAreaId', 'pricingRevision']) &&
        (data.delivery.fee == null || validDeliveryAmount(data.delivery.fee)) &&
        (data.delivery.routeFee == null || validDeliveryAmount(data.delivery.routeFee)) &&
        (data.delivery.customerAreaId == null || validDeliveryArea(data.delivery.customerAreaId)) &&
        (data.delivery.restaurantAreaId == null || validDeliveryArea(data.delivery.restaurantAreaId)) &&
        data.delivery.pricingRevision is int && data.delivery.pricingRevision >= 0
      );
    }

    match /settings/deliveryPricing {
      allow read: if true;
      allow create: if isAdmin() && validDeliveryPricing(request.resource.data) &&
        request.resource.data.revision == 1;
      allow update: if isAdmin() && validDeliveryPricing(request.resource.data) &&
        request.resource.data.revision == resource.data.revision + 1;
      allow delete: if false;
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());

      allow create: if signedIn() && (
        (request.auth.uid == userId && request.resource.data.role == 'customer') ||
        (isAdmin() && request.resource.data.role == 'restaurant')
      );

      allow update: if signedIn() && (
        (
          request.auth.uid == userId &&
          resource.data.role == 'customer' &&
          request.resource.data.role == resource.data.role
        ) ||
        isAdmin()
      );

      allow delete: if isAdmin();
    }

    match /restaurants/{restaurantId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /products/{productId} {
      allow read: if true;

      allow create: if ownsRestaurant(request.resource.data.restaurantId);

      allow update: if ownsRestaurant(resource.data.restaurantId) &&
        request.resource.data.restaurantId == resource.data.restaurantId;

      allow delete: if ownsRestaurant(resource.data.restaurantId) || isAdmin();
    }

    match /restaurantRequests/{requestId} {
      allow create: if isCustomer() && validOrderDelivery(request.resource.data) &&
        request.resource.data.customerId == request.auth.uid &&
        request.resource.data.status == 'pending';

      allow read: if signedIn() && (
        resource.data.customerId == request.auth.uid ||
        ownsRestaurant(resource.data.restaurantId) ||
        isAdmin()
      );

      allow update: if ownsRestaurant(resource.data.restaurantId) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'completedAt']) &&
        request.resource.data.status == 'completed';

      allow delete: if isAdmin();
    }

    // Written only by the trusted Cloud Function through the Admin SDK.
    match /telegramRateLimits/{userId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

